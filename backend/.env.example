# ===== LLM 模型配置 =====
# 主模型（默认阿里云百炼通义千问，OpenAI 兼容协议）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ===== 可观测 =====
# LangSmith 追踪（LangChain/LangGraph 原生集成，填 Key 即自动上报 trace）
# 注册拿 Key：https://smith.langchain.com → Settings → Create API Key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-agent
# Langfuse（可选，未启用）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 数据层 =====
# PostgreSQL 连接串（格式：postgresql://用户:密码@主机:端口/数据库）
POSTGRES_DSN=postgresql://travel_agent:your_password@127.0.0.1:5432/travel_agent
REDIS_URL=redis://localhost:6379/0

# ===== MCP 配置 =====
# MCP Server 地址（本阶段进程内调用，可留空）
MCP_SERVER_URL=
# 高德地图 Web 服务 Key（用于真实 POI 检索）
# 注册：https://lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key（选「Web服务」类型）
AMAP_API_KEY=
WEATHER_API_KEY=

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
