# ===== LLM 模型配置 =====
# 主模型（默认阿里云百炼通义千问，OpenAI 兼容协议）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ===== 可观测 =====
# LangSmith / Langfuse 二选一，本阶段可不填
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-agent
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 数据层（本阶段暂不实际连接，仅预留）=====
POSTGRES_DSN=postgresql://user:password@localhost:5432/travel_agent
REDIS_URL=redis://localhost:6379/0

# ===== MCP 配置 =====
# MCP Server 地址（本阶段进程内调用，可留空）
MCP_SERVER_URL=
# 高德地图 Web 服务 Key（用于真实 POI 检索）
# 注册：https://lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key（选「Web服务」类型）
AMAP_API_KEY=
WEATHER_API_KEY=

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
